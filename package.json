{
  "name": "nyanya-gateway-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Nyanya Gateway and its first-party and compatibility clients",
  "license": "Apache-2.0",
  "workspaces": [
    "gateway",
    "nyanya-gateway-class",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace gateway run start",
    "start:class": "npm --workspace nyanya-gateway-class run start",
    "test": "npm run test:protocol && npm run test:core && npm run test:onebot && npm run test:gateway && npm run test:class",
    "test:protocol": "npm --workspace packages/nyanya-protocol run test",
    "test:core": "npm --workspace packages/gateway-core run test",
    "test:onebot": "npm --workspace packages/onebot-adapter run test",
    "test:gateway": "npm --workspace gateway run test",
    "test:class": "npm --workspace nyanya-gateway-class run test",
    "test:class:legacy": "npm --workspace nyanya-gateway-class run test:legacy",
    "build:j2me": "powershell -ExecutionPolicy Bypass -File ./clients/j2me/tools/build.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File ./tools/package-release.ps1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
