# 网关监听（局域网真机请改 0.0.0.0）
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=14000

# 客户端登录用的设备令牌（请为每个部署设置独立值）
DEVICE_TOKEN=replace-with-a-private-device-token

# NapCat 正向 WebSocket 地址与令牌
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# 心跳与频控
HEARTBEAT_MS=30000
SEND_MIN_INTERVAL_MS=800
SEND_MAX_PER_MINUTE=30
OFFLINE_CAP=200
HISTORY_CAP=100
